{
  "name": "neveroversell",
  "version": "0.1.0",
  "description": "Holds that cannot oversell: Postgres reservations with TTL, a payment phase, idempotent two-path confirmation, a concurrent-safe sweeper and a drift check. One migration, one thin client, the guarantee enforced by the database.",
  "author": "Pavan Gupta <pavan.gupta.352@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavangupta352/neveroversell.git"
  },
  "homepage": "https://github.com/pavangupta352/neveroversell#readme",
  "bugs": {
    "url": "https://github.com/pavangupta352/neveroversell/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "neveroversell": "dist/cli.js"
  },
  "files": [
    "dist",
    "sql",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "bench": "tsx src/cli.ts bench",
    "sync:sql": "cp sql/*.sql python/neveroversell/sql/",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "postgres",
    "inventory",
    "reservation",
    "hold",
    "booking",
    "seat",
    "oversell",
    "idempotent",
    "payment",
    "webhook",
    "concurrency"
  ]
}
